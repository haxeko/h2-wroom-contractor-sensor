	(text "Ghi chu thiet ke (ban module):"
		(exclude_from_sim no)
		(at 20.32 369.57 0)
		(effects (font (size 1.6 1.6) (bold yes)) (justify left bottom))
		(uuid "f24a670e-bb49-5f0c-9cc9-91e876a3a96c")
	)
	(text "1. Module ESP32-H2-WROOM-02C can 3.0-3.6 V -> TPS63900 dat 3.2 V (CFG1 = 30.1k 1%), khong gioi han dong vao."
		(exclude_from_sim no)
		(at 20.32 374.65 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "27eea5ab-ed86-54a4-88cf-ba89eaab0291")
	)
	(text "2. Module da co thach anh 32 MHz, mach RF, anten PCB, tu 3V3 va tu 1 uF tren EN (datasheet v1.2)."
		(exclude_from_sim no)
		(at 20.32 378.46 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "ad398f04-c19d-52b4-8fd8-9fe05c33f5b4")
	)
	(text "3. GPIO giong ban chip roi: firmware dung chung. GPIO8 keo len R11; KHONG dat tu len GPIO9."
		(exclude_from_sim no)
		(at 20.32 383.54 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "ef029c97-0699-5ba9-b743-e1eb03a32524")
	)
	(text "4. Chan VBAT (14) de trong: noi san voi 3V3 ben trong module (mac dinh)."
		(exclude_from_sim no)
		(at 20.32 388.62 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "142967f3-b42b-5aa7-b8b0-955ca6870679")
	)
	(text "5. Anten module nho ra ngoai mep PCB (Espressif: vung anten khong co dong phia duoi)."
		(exclude_from_sim no)
		(at 20.32 392.43 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "f9bb8f71-4f0c-50b3-9435-d511f8d90e82")
	)
	(text "6. Pin CR123A nam ngoai PCB, 2 day 0.15 mm2 han vao J1: 1 = +, 2 = -."
		(exclude_from_sim no)
		(at 20.32 397.51 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "962e9417-03d9-5c34-a228-39b9f8869351")
	)
	(text "7. Sinh tu tools/design_data_wroom.py - chay tools/kicad/gen_schematic.py --variant wroom."
