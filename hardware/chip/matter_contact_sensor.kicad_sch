	(text "PWR_FLAG (nguon cap qua linh kien thu dong)"
		(exclude_from_sim no)
		(at 400.05 347.98 0)
		(effects (font (size 1.8 1.8) (bold yes)) (justify left bottom))
		(uuid "2e573d47-58ea-56b8-94a1-2ce910f25849")
	)
	(text "Ghi chu thiet ke:"
		(exclude_from_sim no)
		(at 20.32 369.57 0)
		(effects (font (size 1.6 1.6) (bold yes)) (justify left bottom))
		(uuid "89911a5e-e84d-58ee-a6ae-46246a26312f")
	)
	(text "1. ESP32-H2 can 3.0-3.6 V -> TPS63900 dat 3.2 V (CFG1 = 30.1k 1%, CFG2 = 0R unlimited, SEL = EN = VIN)."
		(exclude_from_sim no)
		(at 20.32 374.65 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "938bec8c-3da7-537c-90f1-39aa9732187c")
	)
	(text "2. Hall + nut nhan tren LP IO (GPIO10/GPIO9): danh thuc EXT1 khi tat mien TOP trong light sleep."
		(exclude_from_sim no)
		(at 20.32 378.46 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "1bf9365c-75c5-5221-a87b-5e8b60c8fedd")
	)
	(text "3. GPIO8 keo len R11 de vao Joint Download Boot; KHONG dat tu len GPIO9."
		(exclude_from_sim no)
		(at 20.32 383.54 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "a9d712fa-2ce2-5a6b-be12-bc06e4068a64")
	)
	(text "4. Linh kien RF 0201, zigzag, stub 15 mil/100 Ohm o pad GND cua C19 (Espressif). Gia tri chot sau do VNA."
		(exclude_from_sim no)
		(at 20.32 388.62 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "2e5b9310-cce7-502f-a75c-1b96beddba40")
	)
	(text "5. Phan ap do pin chi duoc noi dat qua GPIO22 khi do (0 uA khi nghi)."
		(exclude_from_sim no)
		(at 20.32 392.43 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "636989f8-6c3b-5e62-bfad-4b39a78157f3")
	)
	(text "6. Pin CR123A nam ngoai PCB (tiep diem Keystone 1087-1/1087-2 trong vo), 2 day 0.15 mm2 han vao J1: 1 = +, 2 = -."
		(exclude_from_sim no)
		(at 20.32 397.51 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "962c8025-ac81-5769-9746-cc3b36eab444")
	)
	(text "7. Sinh tu tools/design_data.py - sua du lieu o do roi chay lai tools/kicad/gen_schematic.py."
		(exclude_from_sim no)
		(at 20.32 401.32 0)
		(effects (font (size 1.6 1.6)) (justify left bottom))
		(uuid "d26e658f-6649-575e-92e8-d2a42e9db3c6")
	)
