# =============================================================================
#  Matter Contact Sensor - ESP32-H2FH4S (4 MB in-package flash)
#  ESP-IDF v5.5.5 + esp-matter release/v1.6
#  Base: esp-matter/examples/icd_app/sdkconfig.defaults (Espressif official ICD example)
#  Every option below exists in these SDK versions (checked against the Kconfig sources).
#  Explanations: docs/08_firmware.md, section "sdkconfig".
# =============================================================================

# ----------------------------------------------------------------- Target / flash
CONFIG_IDF_TARGET="esp32h2"
# ESP32-H2FH4S = 4 MB in-package flash (needed for two OTA slots, see partitions.csv)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# ----------------------------------------------------------------- BLE (commissioning only)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
# De-initialise BLE after commissioning and do not start it at boot once provisioned
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=y
# BLE controller may sleep between advertising events; LP clock = main XTAL
# (no 32 kHz crystal populated by default)
CONFIG_BT_LE_SLEEP_ENABLE=y
CONFIG_BT_LE_LP_CLK_SRC_MAIN_XTAL=y
# BLE TX power 0 dBm instead of the ESP-IDF default +9 dBm: the phone is next to the sensor
# during commissioning
CONFIG_BT_LE_DFT_TX_POWER_LEVEL_N0=y

# ----------------------------------------------------------------- Wi-Fi / IPv4 off
CONFIG_ENABLE_WIFI_STATION=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_LWIP_IPV4=n
CONFIG_DISABLE_IPV4=y
CONFIG_LWIP_IPV6_AUTOCONFIG=n
CONFIG_LWIP_ND6=n
CONFIG_LWIP_IPV6_NUM_ADDRESSES=8
CONFIG_LWIP_MULTICAST_PING=y
CONFIG_USE_MINIMAL_MDNS=n

# ----------------------------------------------------------------- OpenThread (MTD = sleepy child)
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_MTD=y
CONFIG_OPENTHREAD_SRP_CLIENT=y
# 1 operational service per fabric (up to 5 admins) + commissionable service
CONFIG_OPENTHREAD_SRP_CLIENT_MAX_SERVICES=6
CONFIG_OPENTHREAD_DNS_CLIENT=y
CONFIG_OPENTHREAD_CLI=n
CONFIG_OPENTHREAD_LOG_LEVEL_DYNAMIC=n
CONFIG_OPENTHREAD_LOG_LEVEL_WARN=y
CONFIG_IEEE802154_SLEEP_ENABLE=y

# ----------------------------------------------------------------- Matter
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=2
CONFIG_SUPPORT_GROUPCAST_CLUSTER=n
# Matter OTA Requestor (two OTA slots in partitions.csv)
CONFIG_ENABLE_OTA_REQUESTOR=y
# Device re-establishes subscriptions itself after a reboot / battery change
CONFIG_ENABLE_PERSIST_SUBSCRIPTIONS=y

# ----------------------------------------------------------------- ICD: Short Idle Time (SIT)
# SIT works with every controller (no ICD registration needed). connectedhomeip enforces
# slow poll <= 15 s for SIT with a static_assert (ICDConfigurationData.h, spec 9.16.1.5).
CONFIG_ENABLE_ICD_SERVER=y
CONFIG_ICD_SLOW_POLL_INTERVAL_MS=15000
CONFIG_ICD_FAST_POLL_INTERVAL_MS=500
# Idle mode duration = longest time between two reports of a subscription (the controller cannot
# ask for less): 1 h instead of 10 min saves ~4 uA of keep-alive reports (8 % of the budget).
# A controller notices a dead sensor after ~1 h; door events are still sent at once.
CONFIG_ICD_IDLE_MODE_INTERVAL_SEC=3600
CONFIG_ICD_ACTIVE_MODE_INTERVAL_MS=1000
CONFIG_ICD_ACTIVE_MODE_THRESHOLD_MS=1000
CONFIG_ENABLE_ICD_USER_ACTIVE_MODE_TRIGGER=y

# ----------------------------------------------------------------- Power management (light sleep)
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
# TOP (digital peripheral) domain off in light sleep: ~25 uA instead of ~85 uA (datasheet
# table 5-9). Marked EXPERIMENTAL in IDF 5.5 but used by Espressif's icd_app on ESP32-H2.
# Consequence: GPIO wake-up only from LP IOs (GPIO7..14) through EXT1.
CONFIG_PM_POWER_DOWN_PERIPHERAL_IN_LIGHT_SLEEP=y
CONFIG_ESP_SLEEP_POWER_DOWN_FLASH=y
CONFIG_ESP_PHY_MAC_BB_PD=y
# Light-sleep entry/exit code in RAM: shorter wake-ups (4 polls a minute for years)
CONFIG_PM_SLP_IRAM_OPT=y
CONFIG_PM_RTOS_IDLE_OPT=y
# Wake-up ISR helpers (gpio_intr_disable/gpio_get_level) placed in IRAM
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y
# Internal 136 kHz RC as RTC slow clock (32.768 kHz crystal footprint is DNP by default)
CONFIG_RTC_CLK_SRC_INT_RC=y

# ----------------------------------------------------------------- Console / logging (development)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# USB-Serial-JTAG clock off: lower sleep current, GPIO26/27 become normal GPIOs
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n
# PRODUCTION log levels. Every log line keeps the CPU awake until the UART has sent it (87 us per
# character at 115200 baud): the INFO/PROGRESS traces of one Matter report cost more charge than
# the report itself. For development add sdkconfig.defaults.debug (README.md).
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_CHIP_LOG_DEFAULT_LEVEL_ERROR=y
CONFIG_CHIP_CONFIG_IM_PRETTY_PRINT=n
# Brownout detector at its highest level (2.94 V): the rail is regulated at 3.2 V, so a drop below
# 2.94 V means the battery cannot follow - reset cleanly (and let the boot guard decide) instead
# of running the flash and the radio below their minimum voltage
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_7=y
